        roe_dv3_pplus = roe_l31_pplus*(U_new[i+2][0] - U_new[i+1][0]) + roe_l32_pplus*(U_new[i+2][1] - U_new[i+1][1]) + roe_l33_pplus*(U_new[i+2][2] - U_new[i+1][2])
        roe_dv3_minus = roe_l31_minus*(U_new[i][0] - U_new[i-1][0]) + roe_l32_minus*(U_new[i][1] - U_new[i-1][1]) + roe_l33_minus*(U_new[i][2] - U_new[i-1][2])
        roe_dv3_mminus = roe_l31_mminus*(U_new[i-1][0] - U_new[i-2][0]) + roe_l32_mminus*(U_new[i-1][1] - U_new[i-2][1]) + roe_l33_mminus*(U_new[i-1][2] - U_new[i-2][2])

        Fp_rho_roe = 0.5*(U_new[i+1][0]*vel_r + U_new[i][0]*vel_c) - 0.5*(abs(roe_lam1_plus)*roe_dv1_plus*roe_r11_plus + abs(roe_lam2_plus)*roe_dv2_plus*roe_r21_plus + abs(roe_lam3_plus)*roe_dv3_plus*roe_r31_plus)
        Fpp_rho_roe = 0.5*(U_new[i+2][0]*vel_rr + U_new[i+1][0]*vel_r) - 0.5*(abs(roe_lam1_pplus)*roe_dv1_pplus*roe_r11_pplus + abs(roe_lam2_pplus)*roe_dv2_pplus*roe_r21_pplus + abs(roe_lam3_pplus)*roe_dv3_pplus*roe_r31_pplus)
        Fm_rho_roe = 0.5*(U_new[i][0]*vel_c + U_new[i-1][0]*vel_l) - 0.5*(abs(roe_lam1_minus)*roe_dv1_minus*roe_r11_minus + abs(roe_lam2_minus)*roe_dv2_minus*roe_r21_minus + abs(roe_lam3_minus)*roe_dv3_minus*roe_r31_minus)
        Fmm_rho_roe = 0.5*(U_new[i-1][0]*vel_l + U_new[i-2][0]*vel_ll) - 0.5*(abs(roe_lam1_mminus)*roe_dv1_mminus*roe_r11_mminus + abs(roe_lam2_mminus)*roe_dv2_mminus*roe_r21_mminus + abs(roe_lam3_mminus)*roe_dv3_mminus*roe_r31_mminus)
        Fp_mom_roe = 0.5*(U_new[i+1][0]*(vel_r**2) + p_r + U_new[i][0]*(vel_c**2) + p_c) - 0.5*(abs(roe_lam1_plus)*roe_dv1_plus*roe_r12_plus + abs(roe_lam2_plus)*roe_dv2_plus*roe_r22_plus + abs(roe_lam3_plus)*roe_dv3_plus*roe_r32_plus)
        Fpp_mom_roe = 0.5*(U_new[i+2][0]*(vel_rr**2) + p_rr + U_new[i+1][0]*(vel_r**2) + p_r) - 0.5*(abs(roe_lam1_pplus)*roe_dv1_pplus*roe_r12_pplus + abs(roe_lam2_pplus)*roe_dv2_pplus*roe_r22_pplus + abs(roe_lam3_pplus)*roe_dv3_pplus*roe_r32_pplus)
        Fm_mom_roe = 0.5*(U_new[i][0]*(vel_c**2) + p_c + U_new[i-1][0]*(vel_l**2) + p_l) - 0.5*(abs(roe_lam1_minus)*roe_dv1_minus*roe_r12_minus + abs(roe_lam2_minus)*roe_dv2_minus*roe_r22_minus + abs(roe_lam3_minus)*roe_dv3_minus*roe_r32_minus)
        Fmm_mom_roe = 0.5*(U_new[i-1][0]*(vel_l**2) + p_l + U_new[i-2][0]*(vel_ll**2) + p_ll) - 0.5*(abs(roe_lam1_mminus)*roe_dv1_mminus*roe_r12_mminus + abs(roe_lam2_mminus)*roe_dv2_mminus*roe_r22_mminus + abs(roe_lam3_mminus)*roe_dv3_mminus*roe_r32_mminus)
        Fp_ener_roe = 0.5*(vel_r*(U_new[i+1][2] + p_r) + vel_c*(U_new[i][2] + p_c)) - 0.5*(abs(roe_lam1_plus)*roe_dv1_plus*roe_r13_plus + abs(roe_lam2_plus)*roe_dv2_plus*roe_r23_plus + abs(roe_lam3_plus)*roe_dv3_plus*roe_r33_plus)
        Fpp_ener_roe = 0.5*(vel_rr*(U_new[i+2][2] + p_rr) + vel_r*(U_new[i+1][2] + p_r)) - 0.5*(abs(roe_lam1_pplus)*roe_dv1_pplus*roe_r13_pplus + abs(roe_lam2_pplus)*roe_dv2_pplus*roe_r23_pplus + abs(roe_lam3_pplus)*roe_dv3_pplus*roe_r33_pplus)
        Fm_ener_roe = 0.5*(vel_c*(U_new[i][2] + p_c) + vel_l*(U_new[i-1][2] + p_l)) - 0.5*(abs(roe_lam1_minus)*roe_dv1_minus*roe_r13_minus + abs(roe_lam2_minus)*roe_dv2_minus*roe_r23_minus + abs(roe_lam3_minus)*roe_dv3_minus*roe_r33_minus)
        Fmm_ener_roe = 0.5*(vel_l*(U_new[i-1][2] + p_l) + vel_ll*(U_new[i-2][2] + p_ll)) - 0.5*(abs(roe_lam1_mminus)*roe_dv1_mminus*roe_r13_mminus + abs(roe_lam2_mminus)*roe_dv2_mminus*roe_r23_mminus + abs(roe_lam3_mminus)*roe_dv3_mminus*roe_r33_mminus)

        F_rho_corr = (1 + w*theta_rho)*(minmod(Fp_rho_lw - Fp_rho_roe, Fm_rho_lw - Fm_rho_roe)) 
        Fp_rho_corr = (1 + w*thetap_rho)*(minmod(Fpp_rho_lw - Fpp_rho_roe, Fp_rho_lw - Fp_rho_roe))
        Fm_rho_corr = (1 + w*thetam_rho)*(minmod(Fm_rho_lw - Fm_rho_roe, Fmm_rho_lw - Fmm_rho_roe                    ))
        G_rho = F_rho_corr + Fp_rho_roe
        Gp_rho = Fp_rho_corr + Fpp_rho_roe
        Gm_rho = Fm_rho_corr + Fm_rho_roe
        F_p_corr = (1 + w*theta_p)*(minmod(Fp_mom_lw - Fp_mom_roe, Fm_mom_lw - Fm_mom_roe))
        Fp_p_corr = (1 + w*thetap_p)*(minmod(Fpp_mom_lw - Fpp_mom_roe, Fp_mom_lw - Fp_mom_roe))
        Fm_p_corr = (1 + w*thetam_p)*(minmod(Fm_mom_lw - Fm_mom_roe, Fmm_mom_lw - Fmm_mom_roe))
        G_p = F_p_corr + Fp_mom_roe
        Gp_p = Fp_p_corr + Fpp_mom_roe
        Gm_p = Fm_p_corr + Fm_mom_roe
        F_ener_corr = (1 + w*theta_ener)*(minmod(Fp_ener_lw - Fp_ener_roe, Fm_ener_lw - Fm_ener_roe))
        Fp_ener_corr = (1 + w*thetap_ener)*(minmod(Fpp_ener_lw - Fpp_ener_roe, Fp_ener_lw - Fp_ener_roe))
        Fm_ener_corr = (1 + w*thetam_ener)*(minmod(Fm_ener_lw - Fm_ener_roe, Fmm_ener_lw - Fmm_ener_roe))
        G_ener = F_ener_corr + Fp_ener_roe
        Gp_ener = Fp_ener_corr + Fpp_ener_roe
        Gm_ener = Fm_ener_corr + Fm_ener_roe

        den_rho_plus = U_new[i+1][0] - U_new[i][0]
        if den_rho_plus == 0:
            G_rho_plus = 0.5*(G_rho + Gp_rho - abs(0.5*(U_new[i][0] + U_new[i+1][0]))*(U_new[i+1][0] - U_new[i][0]))
        else:
            G_rho_plus = 0.5*(G_rho + Gp_rho - abs((Gp_rho - G_rho)/den_rho_plus)*(U_new[i+1][0] - U_new[i][0]))
        den_rho_minus = U_new[i][0] - U_new[i-1][0]
        if den_rho_minus == 0:
            G_rho_minus = 0.5*(G_rho + Gm_rho - abs(0.5*(U_new[i-1][0] + U_new[i][0]))*(U_new[i][0] - U_new[i-1][0]))
        else:
            G_rho_minus = 0.5*(G_rho + Gm_rho - abs((G_rho - Gm_rho)/den_rho_minus)*(U_new[i][0] - U_new[i-1][0]))
        den_p_plus = U_new[i+1][1] - U_new[i][1]
        if den_p_plus == 0:
            G_p_plus = 0.5*(G_p + Gp_p - abs(0.5*(U_new[i][1] + U_new[i+1][1]))*(U_new[i+1][1] - U_new[i][1]))
        else:
            G_p_plus = 0.5*(G_p + Gp_p - abs((Gp_p - G_p)/den_p_plus)*(U_new[i+1][1] - U_new[i][1]))
        den_p_minus = U_new[i][1] - U_new[i-1][1]
        if den_p_minus == 0:
            G_p_minus = 0.5*(G_p + Gm_p - abs(0.5*(U_new[i-1][1] + U_new[i][1]))*(U_new[i][1] - U_new[i-1][1]))
        else:
            G_p_minus = 0.5*(G_p + Gm_p - abs((G_p - Gm_p)/den_p_minus)*(U_new[i][1] - U_new[i-1][1]))
        den_ener_plus = U_new[i+1][2] - U_new[i][2]
        if den_ener_plus == 0:
            G_ener_plus = 0.5*(G_ener + Gp_ener - abs(0.5*(U_new[i][2] + U_new[i+1][2]))*(U_new[i+1][2] - U_new[i][2]))
        else:
            G_ener_plus = 0.5*(G_ener + Gp_ener - abs((Gp_ener - G_ener)/den_ener_plus)*(U_new[i+1][2] - U_new[i][2]))
        den_ener_minus = U_new[i][2] - U_new[i-1][2]
        if den_ener_minus == 0:
            G_ener_minus = 0.5*(G_ener + Gm_ener - abs(0.5*(U_new[i-1][2] + U_new[i][2]))*(U_new[i][2] - U_new[i-1][2]))
        else:
            G_ener_minus = 0.5*(G_ener + Gm_ener - abs((G_ener - Gm_ener)/den_ener_minus)*(U_new[i][2] - U_new[i-1][2]))
    
        rho_new = U_new[i][0] - (dt/dx)*(G_rho_plus - G_rho_minus)
        mom_new = U_new[i][1] - (dt/dx)*(G_p_plus - G_p_minus)
        ener_new = U_new[i][2] - (dt/dx)*(G_ener_plus - G_ener_minus)
        U_add.append([rho_new, mom_new, ener_new])

    U_temp = U_new[:2] + U_add + U_new[-2:]
    U_temp[0] = U_temp[1]
    U_temp[-1] = U_temp[-2]
    U_new = U_temp

    if t + dt > final_time:
        dt = final_time - t   
    t = t + dt

