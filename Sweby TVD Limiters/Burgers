import matplotlib.pyplot as plt
final_time = float(input("Enter final time : "))
final_space = float(input("Enter final space : "))
n_space = int(input("Enter no of space intervals : "))
CFL = float(input("Enter CFL number : "))
dx = final_space/n_space

def minmod(r):
    if r <= 0:
        return 0
    elif r > 0 and r < 1:
        return r
    else:
        return 1
    
def vanleer(r):
    if r >= 0:
        return (2*r)/(1+r)
    else:
        return 0
    
def superbee(r):
    if r <= 0:
        return 0
    elif r > 0 and r < 0.5:
        return 2*r
    elif r >= 0.5 and r < 1:
        return 1
    elif r >= 1 and r < 2:
        return r
    else:
        return 2

space = []
for i in range(n_space):
    val = i*dx
    space.append(val)
u_init_minmod = []
for i in space:
    if i < 1:
        val = 1
    else:
        val = 0
    u_init_minmod.append(val)
u_init_vanleer = u_init_minmod.copy()
u_init_superbee = u_init_minmod.copy()
u_minmod = u_init_minmod.copy()
u_vanleer = u_init_vanleer.copy()
u_superbee = u_init_superbee.copy()

t = 0
while t < final_time:
    dt = CFL*dx/max(abs(val) for val in u_minmod)
    u=[]
    for i in range(n_space):
        ip = (i+1)%n_space
        ipp = (i+2)%n_space
        im = (i-1)%n_space
        imm = (i-2)%n_space
        
        if u_minmod[i] > 0:
            ap = (u_minmod[ip] + u_minmod[i])/2
            am = (u_minmod[i] + u_minmod[im])/2
            amm = (u_minmod[im] + u_minmod[imm])/2
            denr = ap*(1 - (dt/dx)*ap)*(u_minmod[ip] - u_minmod[i])
            if denr == 0:
                r = 0
            else:
                r = (am*(1 - (dt/dx)*am)*(u_minmod[i] - u_minmod[im]))/denr
            denrm = am*(1 - (dt/dx)*am)*(u_minmod[i] - u_minmod[im])
            if denrm == 0:
                rm = 0
            else:
                rm = (amm*(1 - (dt/dx)*amm)*(u_minmod[im] - u_minmod[imm]))/denrm
    
            f_plus = 0.5*u_minmod[i]**2 + 0.5*ap*(1 - (dt/dx)*ap)*minmod(r)*(u_minmod[ip] - u_minmod[i])
            f_minus = 0.5*u_minmod[im]**2 + 0.5*am*(1 - (dt/dx)*am)*minmod(rm)*(u_minmod[i] - u_minmod[im])
            x = u_minmod[i] - (dt/dx)*(f_plus - f_minus)
            u.append(x)

        elif u_minmod[i] < 0:
            ap = (u_minmod[ip] + u_minmod[i])/2
            app = (u_minmod[ip] + u_minmod[ipp])/2
            am = (u_minmod[i] + u_minmod[im])/2
            denrp = ap*(1 + (dt/dx)*ap)*(u_minmod[ip] - u_minmod[i])
            if denrp == 0:
                rp = 0
            else:
                rp = (app*(1 + (dt/dx)*app)*(u_minmod[ipp] - u_minmod[ip]))/denrp
            denr = am*(1 + (dt/dx)*am)*(u_minmod[i] - u_minmod[im])
            if denr == 0:
                r = 0
            else:
                r = (ap*(1 + (dt/dx)*ap)*(u_minmod[ip] - u_minmod[i]))/denr
            f_plus = 0.5*u_minmod[ip]**2 - 0.5*ap*(1 + (dt/dx)*ap)*minmod(rp)*(u_minmod[ip] - u_minmod[i])
            f_minus = 0.5*u_minmod[i]**2 - 0.5*am*(1 + (dt/dx)*am)*minmod(r)*(u_minmod[i] - u_minmod[im])
            x = u_minmod[i] - (dt/dx)*(f_plus - f_minus)
            u.append(x)
        
        else:
            ap_plus = max(0, 0.5*(u_minmod[ip] + u_minmod[i]))
            ap_minus = min(0, 0.5*(u_minmod[ip] + u_minmod[i]))
            app_plus = max(0, 0.5*(u_minmod[ipp] + u_minmod[ip]))
            app_minus = min(0, 0.5*(u_minmod[ipp] + u_minmod[ip]))
            am_plus = max(0, 0.5*(u_minmod[i] + u_minmod[im]))
            am_minus = min(0, 0.5*(u_minmod[i] + u_minmod[im]))
            amm_plus = max(0, 0.5*(u_minmod[im] + u_minmod[imm]))
            amm_minus = min(0, 0.5*(u_minmod[im] + u_minmod[imm]))

            denr_plus = ap_plus*(1 - (dt/dx)*ap_plus)*(u_minmod[ip] - u_minmod[i])
            if denr_plus == 0:
                r_plus = 0
            else:
                r_plus = (am_plus*(1 - (dt/dx)*am_plus)*(u_minmod[i] - u_minmod[im]))/denr_plus

