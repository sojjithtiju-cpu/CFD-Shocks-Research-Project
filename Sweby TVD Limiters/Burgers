            else:
                rm_plus = (amm_plus*(1 - (dt/dx)*amm_plus)*(u_minmod[im] - u_minmod[imm]))/denrm_plus
            
            denrm_minus = am_minus*(1 + (dt/dx)*am_minus)*(u_minmod[i] - u_minmod[im])
            if denrm_minus == 0:
                rm_minus = 0
            else:
                rm_minus = (ap_minus*(1 + (dt/dx)*ap_minus)*(u_minmod[ip] - u_minmod[i]))/denrm_minus
            
            ap = 0.5*(u_minmod[ip] + u_minmod[i])
            am = 0.5*(u_minmod[i] + u_minmod[im])
            if ap >= 0:
                init_fluxp = 0.5*u_minmod[i]**2
            else:
                init_fluxp = 0.5*u_minmod[ip]**2
            if am >= 0:
                init_fluxm = 0.5*u_minmod[im]**2
            else:
                init_fluxm = 0.5*u_minmod[i]**2

            f_plus = init_fluxp + 0.5*(ap_plus*(1 - (dt/dx)*ap_plus)*minmod(r_plus) - ap_minus*(1 + (dt/dx)*ap_minus)*minmod(r_minus))*(u_minmod[ip] - u_minmod[i])
            f_minus = init_fluxm + 0.5*(am_plus*(1 - (dt/dx)*am_plus)*minmod(rm_plus) - am_minus*(1 + (dt/dx)*am_minus)*minmod(rm_minus))*(u_minmod[i] - u_minmod[im])
            x = u_minmod[i] - (dt/dx)*(f_plus - f_minus)
            u.append(x)
    u_minmod = u.copy()

