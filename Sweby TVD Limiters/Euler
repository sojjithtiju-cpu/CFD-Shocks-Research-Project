        rho_loop2_plus = superbee(r1_minus)*dv1_plus*r11_plus*lam1_plus*(1 + (dt/dx)*lam1_plus) + superbee(r2_minus)*dv2_plus*r21_plus*lam2_plus*(1 + (dt/dx)*lam2_plus) + superbee(r3_minus)*dv3_plus*r31_plus*lam3_plus*(1 + (dt/dx)*lam3_plus)
        mom_loop1_plus = superbee(r1_plus)*dv1_plus*r12_plus*lam1_plus*(1 - (dt/dx)*lam1_plus) + superbee(r2_plus)*dv2_plus*r22_plus*lam2_plus*(1 - (dt/dx)*lam2_plus) + superbee(r3_plus)*dv3_plus*r32_plus*lam3_plus*(1 - (dt/dx)*lam3_plus)
        mom_loop2_plus = superbee(r1_minus)*dv1_plus*r12_plus*lam1_plus*(1 + (dt/dx)*lam1_plus) + superbee(r2_minus)*dv2_plus*r22_plus*lam2_plus*(1 + (dt/dx)*lam2_plus) + superbee(r3_minus)*dv3_plus*r32_plus*lam3_plus*(1 + (dt/dx)*lam3_plus)
        en_loop1_plus = superbee(r1_plus)*dv1_plus*r13_plus*lam1_plus*(1 - (dt/dx)*lam1_plus) + superbee(r2_plus)*dv2_plus*r23_plus*lam2_plus*(1 - (dt/dx)*lam2_plus) + superbee(r3_plus)*dv3_plus*r33_plus*lam3_plus*(1 - (dt/dx)*lam3_plus)
        en_loop2_plus = superbee(r1_minus)*dv1_plus*r13_plus*lam1_plus*(1 + (dt/dx)*lam1_plus) + superbee(r2_minus)*dv2_plus*r23_plus*lam2_plus*(1 + (dt/dx)*lam2_plus) + superbee(r3_minus)*dv3_plus*r33_plus*lam3_plus*(1 + (dt/dx)*lam3_plus)
        rho_loop1_minus = superbee(rl1_plus)*dv1_minus*r11_minus*lam1_minus*(1 - (dt/dx)*lam1_minus) + superbee(rl2_plus)*dv2_minus*r21_minus*lam2_minus*(1 - (dt/dx)*lam2_minus) + superbee(rl3_plus)*dv3_minus*r31_minus*lam3_minus*(1 - (dt/dx)*lam3_minus)
        rho_loop2_minus = superbee(rl1_minus)*dv1_minus*r11_minus*lam1_minus*(1 + (dt/dx)*lam1_minus) + superbee(rl2_minus)*dv2_minus*r21_minus*lam2_minus*(1 + (dt/dx)*lam2_minus) + superbee(rl3_minus)*dv3_minus*r31_minus*lam3_minus*(1 + (dt/dx)*lam3_minus)
        mom_loop1_minus = superbee(rl1_plus)*dv1_minus*r12_minus*lam1_minus*(1 - (dt/dx)*lam1_minus) + superbee(rl2_plus)*dv2_minus*r22_minus*lam2_minus*(1 - (dt/dx)*lam2_minus) + superbee(rl3_plus)*dv3_minus*r32_minus*lam3_minus*(1 - (dt/dx)*lam3_minus)
        mom_loop2_minus = superbee(rl1_minus)*dv1_minus*r12_minus*lam1_minus*(1 + (dt/dx)*lam1_minus) + superbee(rl2_minus)*dv2_minus*r22_minus*lam2_minus*(1 + (dt/dx)*lam2_minus) + superbee(rl3_minus)*dv3_minus*r32_minus*lam3_minus*(1 + (dt/dx)*lam3_minus)
        en_loop1_minus = superbee(rl1_plus)*dv1_minus*r13_minus*lam1_minus*(1 - (dt/dx)*lam1_minus) + superbee(rl2_plus)*dv2_minus*r23_minus*lam2_minus*(1 - (dt/dx)*lam2_minus) + superbee(rl3_plus)*dv3_minus*r33_minus*lam3_minus*(1 - (dt/dx)*lam3_minus)
        en_loop2_minus = superbee(rl1_minus)*dv1_minus*r13_minus*lam1_minus*(1 + (dt/dx)*lam1_minus) + superbee(rl2_minus)*dv2_minus*r23_minus*lam2_minus*(1 + (dt/dx)*lam2_minus) + superbee(rl3_minus)*dv3_minus*r33_minus*lam3_minus*(1 + (dt/dx)*lam3_minus)

        rhoflux_plus = roe_rhoflux_plus + 0.5*(rho_loop1_plus - rho_loop2_plus)
        rhoflux_minus = roe_rhoflux_minus + 0.5*(rho_loop1_minus - rho_loop2_minus)
        momflux_plus = roe_momflux_plus + 0.5*(mom_loop1_plus - mom_loop2_plus)
        momflux_minus = roe_momflux_minus + 0.5*(mom_loop1_minus - mom_loop2_minus)
        enflux_plus = roe_enflux_plus + 0.5*(en_loop1_plus - en_loop2_plus)
        enflux_minus = roe_enflux_minus + 0.5*(en_loop1_minus - en_loop2_minus)

        rho_new = U_superbee[i][0] - (dt/dx)*(rhoflux_plus - rhoflux_minus)
        mom_new = U_superbee[i][1] - (dt/dx)*(momflux_plus - momflux_minus)
        ener_new = U_superbee[i][2] - (dt/dx)*(enflux_plus - enflux_minus)
        U_add.append([rho_new, mom_new, ener_new])

    U_temp = [U_superbee[0], U_superbee[1]] + U_add + [U_superbee[-2], U_superbee[-1]]
    U_temp[0] = U_temp[1]
    U_temp[-1] = U_temp[-2]
    U_superbee = U_temp

    t = t + dt

